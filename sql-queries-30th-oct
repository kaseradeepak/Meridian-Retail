--  WITH keyword allows us to write the rough work and give it some name, 
--  this named result is called as CTE (Common Table Expression)
--  a CTE doesn't get stored in the database, it is for temporary usage.
WITH reviewed_case_ids AS (
  SELECT DISTINCT case_id
  FROM human_reviews
)

SELECT ir.issue_type,
       COUNT(*) AS total_cases,
       COUNT(rc.case_id) AS reviewed_cases
FROM issue_records AS ir
LEFT JOIN reviewed_case_ids AS rc
  ON rc.case_id = ir.case_id
GROUP BY ir.issue_type
ORDER BY total_cases DESC, ir.issue_type;

-- WITH keyword can hold for more than one step as well, separated by comma. 

WITH reviewed_case_ids AS (
  SELECT DISTINCT case_id
  FROM human_reviews
),
issue_coverage AS (
  SELECT ir.issue_type,
         COUNT(*) AS total_cases,
         COUNT(rc.case_id) AS reviewed_cases
  FROM issue_records AS ir
  LEFT JOIN reviewed_case_ids AS rc
    ON rc.case_id = ir.case_id
  GROUP BY ir.issue_type
)
SELECT issue_type, total_cases, reviewed_cases,
       ROUND(100.0 * reviewed_cases / total_cases, 1) AS pct_reviewed
FROM issue_coverage
ORDER BY total_cases DESC, issue_type;

WITH rule_usage AS (
  SELECT triggered_rule_id, COUNT(*) AS review_events
  FROM human_reviews
  WHERE triggered_rule_id IS NOT NULL
  GROUP BY triggered_rule_id
)
SELECT vr.rule_id, vr.failure_route, ru.review_events
FROM validation_rules AS vr
LEFT JOIN rule_usage AS ru
  ON ru.triggered_rule_id = vr.rule_id
ORDER BY vr.rule_id;


