-- where clause is used to filter rows on a particular condition.
select * from orders where order_id = 'MR-501';

select * from orders where payment_status = 'PAID';

select * from human_reviews where case_id = 'MCS-502';


-- Get all the orders which were placed after 15th March, 2026
select * from orders where order_date > '2026-03-15';

SELECT COUNT(*) FROM orders; -- Count of all the orders.

-- Get the count of all the orders which haven't been delivered yet.
-- order not delivered means delivery_date is Null.

select COUNT(*) from orders where delivery_date IS null;

-- ORDER BY

select * from support_cases order by received_at desc;

-- give the order_id, product, order_date and delivery_date of each order.
select order_id, product, order_date, delivery_date 
from orders
where delivery_date is null
order by order_id
limit 5;


