-- Get all the pending cases which are of type delivery or billing
select * from support_cases
where review_status = 'PENDING'
AND (case_type = 'DELIVERY' or case_type = 'BILLING');

select * from support_cases
where review_status = 'PENDING'
AND case_type IN ('DELIVERY', 'BILLING', 'DAMAGE');


select * from support_cases;

-- Get all the cases in which customer question contains the word refund.
select * from support_cases
where customer_question LIKE '%package%';

-- % -> any number of characters.
-- _ -> exactly one occurrence 


