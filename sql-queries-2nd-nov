-- VIEW 

CREATE VIEW sample_view as 
select distinct sc.case_id as rows_returned,
hr.review_id as review_id, 
hr.triggered_rule_id as rule_id,
vr.condition_text as rule_inforows_returnedreview_id
from support_cases sc
left join human_reviews hr
on sc.case_id = hr.case_id AND hr.triggered_rule_id IS NOT NULL
join -- inner join is the default join.
validation_rules vr
on hr.triggered_rule_id = vr.rule_id;


