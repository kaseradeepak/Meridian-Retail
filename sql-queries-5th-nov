-- ---------------------------------------------------------------------
-- 3. Generate rows
--    Six cross-joined digit tables give numbers 1 .. 1,000,000.
--    CRC32(...) acts as a repeatable "random" number so the data
--    looks shuffled but is the same every time you run the script.
-- ---------------------------------------------------------------------
INSERT INTO customers
    (first_name, last_name, email, phone, gender, date_of_birth,
     city, state, signup_date, is_active, total_spent)
SELECT
    f.name,
    l.name,
    CONCAT(LOWER(f.name), '.', LOWER(l.name), s.n, '@',
           ELT(1 + CRC32(CONCAT('d', s.n)) % 5,
               'gmail.com', 'yahoo.com', 'outlook.com', 'hotmail.com', 'rediffmail.com')),
    CONCAT(ELT(1 + CRC32(CONCAT('p', s.n)) % 4, '9', '8', '7', '6'),
           LPAD(CRC32(CONCAT('ph', s.n)) % 1000000000, 9, '0')),
    f.gender,
    DATE_ADD('1965-01-01', INTERVAL CRC32(CONCAT('b', s.n)) % 14600 DAY),   -- ~1965–2004
    c.city,
    c.state,
    DATE_ADD('2018-01-01', INTERVAL CRC32(CONCAT('s', s.n)) % 276480000 SECOND), -- 2018 → ~2026
    IF(CRC32(CONCAT('a', s.n)) % 10 < 8, 1, 0),                               -- ~80% active
    ROUND((CRC32(CONCAT('t', s.n)) % 50000000) / 100, 2)                      -- ₹0 – ₹5,00,000
FROM (
    SELECT 1 + a.d + b.d*10 + c.d*100 + d.d*1000 + e.d*10000 + g.d*100000 AS n
    FROM tmp_digits a, tmp_digits b, tmp_digits c,
         tmp_digits d, tmp_digits e, tmp_digits g
) s
JOIN tmp_first_names f ON f.id = 1 + CRC32(CONCAT('f', s.n)) % 50
JOIN tmp_last_names  l ON l.id = 1 + CRC32(CONCAT('l', s.n)) % 40
JOIN tmp_cities      c ON c.id = 1 + CRC32(CONCAT('c', s.n)) % 25
WHERE s.n <= @total_rows
ORDER BY s.n;
 
