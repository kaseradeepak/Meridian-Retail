-- Q: Which products have more than 1200 orders?

select * from orders;

-- number of orders per product.

select product as product_name, 
count(*) as number_of_orders
from orders
group by product
HAVING number_of_orders > 1200;

-- Error Code: 1111. Invalid use of group function

-- where clause is used to filter rows.
-- where clause can't be used with group.
-- To filter groups, we need to use HAVING clause.

-- where : filter rows.
-- having : filter groups.

select product as product_name, 
count(*) as number_of_orders,
payment_status
from orders
group by product
HAVING number_of_orders > 1000
order by number_of_orders desc;

-- Error Code: 1055. Expression #3 of 
-- SELECT list is not in GROUP BY clause and contains nonaggregated column 
-- 'meridian_retail.orders.payment_status' which is not functionally 
-- dependent on columns in GROUP BY clause; this is incompatible 
-- with sql_mode=only_full_group_by

select * FROM human_reviews;

SELECT reviewer_role,
       COUNT(*) AS review_events,
       MIN(handling_minutes) AS fastest_minutes,
       MAX(handling_minutes) AS slowest_minutes,
       ROUND(AVG(handling_minutes), 2) AS average_minutes
FROM human_reviews
GROUP BY reviewer_role
ORDER BY average_minutes DESC, reviewer_role;

