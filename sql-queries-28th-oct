-------------- JOIN Queries ------------------

SELECT support_cases.case_id, review_status, review_id, decision
FROM support_cases
INNER JOIN human_reviews
ON human_reviews.case_id = support_cases.case_id;

-- Error Code: 1052. Column 'case_id' in field list is ambiguous

SELECT sc.case_id, review_status, review_id, decision
FROM support_cases sc
INNER JOIN human_reviews hr
ON hr.case_id = sc.case_id
where sc.case_id = 'MCS-000005';

-- Error Code: 1052. Column 'case_id' in where clause is ambiguous


SELECT sc.case_id, review_status, review_id, decision
FROM support_cases sc
INNER JOIN human_reviews hr
ON hr.case_id = sc.case_id
where sc.case_id IN ('MCS-501', 'MCS-502')
order by sc.case_id;

SELECT sc.case_id, sc.review_status, hr.review_id, hr.decision
FROM support_cases sc
LEFT JOIN human_reviews hr
ON hr.case_id = sc.case_id
WHERE sc.case_id IN ('MCS-501', 'MCS-502')
ORDER BY sc.case_id;

select count(*) from issue_records;

select count(*) from human_reviews;

SELECT 
COUNT(*) AS total_joined_rows,
COUNT(distinct hr.case_id) AS reviewed_cases
FROM issue_records AS ir
INNER JOIN human_reviews AS hr
ON hr.case_id = ir.case_id;


select count(*) from support_cases;

select 
count(*) as total_join_rows, -- 27000 
count(distinct sc.case_id) as total_cases,
count(hr.review_id) as reviewed_events
from support_cases sc
left join human_reviews hr
on sc.case_id = hr.case_id;

-- Show me all 25,000 cases. Where a case has a review that names a validation rule, attach that review.

select count(*) as rows_returned
from support_cases sc
left join human_reviews hr
on sc.case_id = hr.case_id
where hr.triggered_rule_id IS NOT NULL;


select count(distinct sc.case_id) as rows_returned,
count(hr.review_id) as review_id
from support_cases sc
left join human_reviews hr
on sc.case_id = hr.case_id AND hr.triggered_rule_id IS NOT NULL;

